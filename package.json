{
  "name": "inv-dds-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.invdds.pro.app",
    "productName": "INV-DDS-PRO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512x512.png"
    }
  },
  "dependencies": {
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
